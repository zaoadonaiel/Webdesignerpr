{
  // Cloudflare Workers configuration for webdesignerpr.com
  //
  // This file exists so Wrangler does NOT guess. Without it, `wrangler deploy`
  // auto-detects a static output folder, finds admin/index.html (the only
  // index.html in the repo) and publishes the CMS as the whole site.
  //
  // The site is an assets-only Worker: no `main` entrypoint, just the built
  // files in dist/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webdesignerpr",
  "compatibility_date": "2026-09-21",

  // Regenerate dist/ before uploading. The Workers Builds "build command"
  // setting does the same thing; having both is deliberate belt-and-braces,
  // and running it twice is harmless — the build is deterministic and takes
  // about 30ms.
  "build": {
    "command": "python3 build.py"
  },

  "assets": {
    "directory": "dist",
    // /about -> /about.html, and /about.html stays put
    "html_handling": "auto-trailing-slash",
    // anything unmatched gets the bilingual 404 page
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  },

  // Keep the *.workers.dev URL as a fallback for testing. The canonical tags
  // on every page point at webdesignerpr.com, so it will not compete in search.
  // Set both to false once you are confident in the custom domain.
  "workers_dev": true,
  "preview_urls": true
}
